# NHR Solution — environment variable NAMES ONLY.
#
# Copy to .env and fill in locally:   cp .env.example .env
# .env is gitignored and must never be committed. No real value belongs in this
# file, including for local development — a weak local password committed once
# tends to reappear in staging.

# ---------------------------------------------------------------- runtime
NODE_ENV=development
LOG_LEVEL=debug

# ---------------------------------------------------------------- api
API_PORT=4000
API_HOST=127.0.0.1
# Comma-separated list of origins allowed to send credentialed requests.
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------- web
# Baked into the frontend bundle at build time, so it must contain no secrets.
VITE_API_URL=http://localhost:4000

# ---------------------------------------------------------------- postgres
# Phase 2 introduces the schema. docker-compose reads these to create the
# container, and the API reads them to connect. Nothing uses them in Phase 0.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nhr_dev
POSTGRES_USER=nhr
POSTGRES_PASSWORD=
# Assembled from the parts above; set it directly if you prefer a single URL.
DATABASE_URL=

# ---------------------------------------------------------------- redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=

# ---------------------------------------------------------------- auth (phase 2)
# 32+ random bytes, base64. Generate with:  openssl rand -base64 48
SESSION_SECRET=
SESSION_ABSOLUTE_HOURS=12
SESSION_IDLE_MINUTES=60
# Envelope-encryption key for ni_number, sort code and account number.
FIELD_ENCRYPTION_KEY=

# ---------------------------------------------------------------- object storage (phase 5)
S3_ENDPOINT=
S3_REGION=eu-west-2
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------- email (phase 5)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="NHR Solution <no-reply@example.invalid>"

# ---------------------------------------------------------------- supabase
# Publishable key only — it is sent to every browser and is safe in the client.
# Access is controlled by row-level security, not by hiding this key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
